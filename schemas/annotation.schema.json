{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fersandovalgtz/practica-docente-historica-digital/schemas/annotation.schema.json",
  "title": "PDHD human annotation",
  "description": "Semantic annotation record. Completeness and access-problem exceptions are enforced by the dedicated validators; this schema defines field identity and controlled values.",
  "type": "object",
  "required": ["annotation_id", "fragment_id", "document_id", "codebook_version", "coder_id"],
  "properties": {
    "annotation_id": {"type": "string", "minLength": 1},
    "fragment_id": {"type": "string", "pattern": "^PDHD-F[0-9]{6}$"},
    "document_id": {"type": "string", "pattern": "^PDHD-D[0-9]{6}$"},
    "page": {"type": ["integer", "string", "null"]},
    "fragment_locator": {"type": ["string", "null"]},
    "codebook_version": {"type": "string", "minLength": 1},
    "coder_id": {"type": "string", "pattern": "^C[0-9]{2,3}$"},
    "pedagogical_act_primary": {"type": ["string", "null"]},
    "pedagogical_act_secondary": {"type": ["string", "null"]},
    "dimension_teaching_method": {"enum": ["0", "1", ""]},
    "dimension_teacher_authority": {"enum": ["0", "1", ""]},
    "dimension_discipline": {"enum": ["0", "1", ""]},
    "dimension_assessment": {"enum": ["0", "1", ""]},
    "dimension_materials": {"enum": ["0", "1", ""]},
    "dimension_lesson_organization": {"enum": ["0", "1", ""]},
    "dimension_teacher_training": {"enum": ["0", "1", ""]},
    "dimension_inspection_supervision": {"enum": ["0", "1", ""]},
    "dimension_rurality": {"enum": ["0", "1", ""]},
    "dimension_indigenous_education": {"enum": ["0", "1", ""]},
    "dimension_inclusion_difference": {"enum": ["0", "1", ""]},
    "dimension_gender": {"enum": ["0", "1", ""]},
    "dimension_student_conception": {"enum": ["0", "1", ""]},
    "dimension_professional_identity": {"enum": ["0", "1", ""]},
    "dimension_school_community": {"enum": ["0", "1", ""]},
    "dimension_pedagogical_change": {"enum": ["0", "1", ""]},
    "normativity": {"enum": ["prescriptive", "policy_normative", "descriptive", "reported_practice", "observed_practice", "testimonial", "analytical", "mixed", "unclear", ""]},
    "actor": {"enum": ["teacher", "student", "inspector", "director", "family", "community", "state_authority", "other", "unclear", ""]},
    "target": {"enum": ["student", "teacher", "family", "community", "institution", "self", "other", "unclear", ""]},
    "evidence_confidence": {"enum": ["high", "medium", "low", ""]},
    "access_problem": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]},
    "annotated_at": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
