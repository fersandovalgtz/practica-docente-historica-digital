{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fersandovalgtz/practica-docente-historica-digital/schemas/pedagogical_fragment.schema.json",
  "title": "PDHD pedagogical fragment",
  "type": "object",
  "required": ["fragment_id", "document_id", "fragment_locator", "dimension", "normativity", "validation_status", "rights_status"],
  "properties": {
    "fragment_id": {"type": "string", "pattern": "^PDHD-F[0-9]{6}$"},
    "document_id": {"type": "string", "pattern": "^PDHD-D[0-9]{6}$"},
    "fragment_locator": {"type": "string", "minLength": 1},
    "page": {"type": ["integer", "string", "null"]},
    "transcription_status": {"enum": ["none", "local_ocr_unverified", "human_transcribed", "text_verified"]},
    "pedagogical_act": {"type": ["string", "null"]},
    "dimension": {"type": "string", "minLength": 1},
    "actor": {"type": ["string", "null"]},
    "target": {"type": ["string", "null"]},
    "normativity": {"enum": ["prescriptive", "descriptive", "reported_practice", "observed_practice", "analytical", "unclear"]},
    "validation_status": {"enum": ["unvalidated", "human_validated", "rejected", "needs_review"]},
    "rights_status": {"type": "string"}
  },
  "additionalProperties": true
}
